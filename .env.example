# Copy this file to .env and fill in your values. Never commit .env!

# --- Web app -----------------------------------------------------------
GROWCAM_PORT=8080
# GROWCAM_DATA_DIR=C:\GrowCamData   (default: .\data next to the code)

# --- Tapo camera (leave TAPO_HOST empty for demo mode) -------------------
# IP of the camera (assign a fixed IP in your router)
TAPO_HOST=
# "Camera account" created in the Tapo app: Camera settings > Advanced > Camera account
TAPO_RTSP_USER=
TAPO_RTSP_PASSWORD=
# Password of your TP-Link/Tapo app login – only needed for moving the camera
TAPO_CLOUD_PASSWORD=
# Full path if ffmpeg is not on PATH, e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg

# --- AI (leave empty for demo answers) -----------------------------------
# Create a key at https://platform.claude.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Schedule --------------------------------------------------------------
ANALYSIS_TIME=12:00
REPORT_TIME=20:00
# Extra photos for the history/time-lapse; 0 = off
SNAPSHOT_INTERVAL_MINUTES=60
# Light cycle – photos are only taken while the light is on
LIGHT_ON=06:00
LIGHT_OFF=00:00
